{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "semi": false,
  "singleQuote": true,
  "trailingComma": "all",
  "printWidth": 90,
  "tabWidth": 2,
  "useTabs": false,
  "sortPackageJson": false,
  "ignorePatterns": [
    "dist/**",
    ".astro/**",
    "pnpm-lock.yaml",
    "**/*.astro",
    "src/content/**"
  ]
}
