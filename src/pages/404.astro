---
import Layout from '@layouts/Layout.astro'
import { t } from '../i18n'
---

<script is:inline>
  ;(() => {
    const nextPath = location.pathname.replace(/^\/(en|es)(?=\/|$)/, '') || '/'
    if (nextPath !== location.pathname) {
      location.replace(nextPath + location.search + location.hash)
    }
  })()
</script>

<Layout title={t('notFound.title')}>
  <div class="flex flex-col items-center justify-center min-h-[60vh] text-center">
    <h1 class="text-6xl font-bold text-accent mb-4">404</h1>
    <h2 class="text-2xl font-semibold mb-4">{t('notFound.title')}</h2>
    <p class="text-muted-foreground mb-8 max-w-md">
      {t('notFound.message')}
    </p>
    <a
      href="/"
      class="px-6 py-3 bg-accent text-background font-semibold rounded-lg hover:bg-accent/90 transition-colors"
    >
      {t('notFound.backHome')}
    </a>
  </div>
</Layout>
