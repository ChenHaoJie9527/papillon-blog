---
import Layout from '@layouts/Layout.astro'
import { t } from '../i18n'
import { withBase } from '@utils'
---

<script is:inline define:vars={{ basePath: import.meta.env.BASE_URL }}>
  ;(() => {
    // Runs on 404s so that legacy `/en/...` and `/es/...` URLs still resolve when
    // they land here instead of on a served redirect page. `basePath` is empty
    // when the site is deployed at the domain root.
    const prefix = String(basePath || '').replace(/\/$/, '')
    const pathname = location.pathname
    if (pathname !== prefix && !pathname.startsWith(`${prefix}/`)) return
    const rest = pathname.slice(prefix.length)
    const nextPath = rest.replace(/^\/(en|es)(?=\/|$)/, '') || '/'
    if (nextPath === rest) return
    location.replace(prefix + nextPath + location.search + location.hash)
  })()
</script>

<Layout title={t('notFound.title')}>
  <div class="flex flex-col items-center justify-center min-h-[60vh] text-center">
    <h1 class="text-6xl font-bold text-accent mb-4">404</h1>
    <h2 class="text-2xl font-semibold mb-4">{t('notFound.title')}</h2>
    <p class="text-muted-foreground mb-8 max-w-md">
      {t('notFound.message')}
    </p>
    <a
      href={withBase('/')}
      class="press-scale px-6 py-3 bg-accent text-background font-semibold rounded-lg hover:bg-accent/90"
    >
      {t('notFound.backHome')}
    </a>
  </div>
</Layout>
