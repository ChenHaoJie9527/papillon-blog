---
import Layout from "@layouts/Layout.astro";
import { getSortedPosts, withBase } from "@utils";
import { getCollection, render } from "astro:content";
import HomeBanner from "@components/HomeBanner.astro";
import TagsSection from "@components/TagsSection.astro";
import PostLogItem from "@components/PostLogItem.astro";
import Pagination from "@components/Pagination.astro";
import siteConfig from "../site.config";
import { t } from "../i18n";

const home = await getCollection("home");
let HomeContent: any;
let homeAvatarImage: any;
let homeGithubCalendar: any;
if (home.length > 0) {
	const homeEntry = home[0];
	const { Content } = await render(homeEntry);
	HomeContent = Content;
	homeAvatarImage = homeEntry.data.avatarImage;
	homeGithubCalendar = homeEntry.data.githubCalendar;
}
const sortedPosts = await getSortedPosts();
const dashboardPosts = sortedPosts.slice(0, siteConfig.pageSize);
---

<Layout 
  title={t('nav.dashboard')}
  description={t('home.description')}
>
  {
    HomeContent && (
      <HomeBanner avatarImage={homeAvatarImage} githubCalendar={homeGithubCalendar}>
        <HomeContent />
      </HomeBanner>
    )
  }
  <h2 class="text-xs tracking-wide text-foreground/50 font-medium mb-2">{t('nav.tags')}</h2>
  <TagsSection posts={sortedPosts} />
  <h2 class="text-xs tracking-wide text-foreground/50 font-medium mt-6 mb-1">{t('nav.latestPosts')}</h2>
  <div>
    {dashboardPosts.map((post) => (
      <PostLogItem post={post} />
    ))}
  </div>
  <Pagination nextLink={withBase('/posts')} nextText={t('nav.archive')} />
</Layout>

<style is:global>
  a.heading-anchor {
    display: none !important;
  }
</style>
