---
import Layout from '@layouts/Layout.astro'
import { t } from '../i18n'
import BlockHeader from '@components/BlockHeader.astro'
import type { ComponentsData } from '../custom-components'

const componentsData: ComponentsData = await import('../custom-components.json')
const { components } = componentsData
const categories = [...new Set(components.map((component) => component.category))]

const categoryLabel = (category: string) => {
  const key = `components.category${category}`
  const translated = t(key)
  return translated === key ? category : translated
}
---

<Layout title={t('nav.components')} description={t('nav.components')}>
  <BlockHeader>{t('components.showcase')}</BlockHeader>
  <div class="mb-8 p-4 bg-accent/5 rounded-xl border border-accent/10">
    <div class="flex flex-col sm:flex-row gap-4 items-stretch sm:items-end justify-between">
      <div class="flex-1 max-w-md">
        <label for="search-input" class="block text-sm font-medium text-accent mb-2">
          {t('components.searchLabel')}
        </label>
        <input
          type="search"
          id="search-input"
          name="component-search"
          autocomplete="off"
          placeholder={t('components.searchPlaceholder')}
          class="w-full text-base px-4 py-2 bg-background border border-accent rounded-lg"
        />
      </div>
      <div class="flex gap-2 items-end">
        <div>
          <label for="category-filter" class="block text-sm font-medium text-accent mb-2">
            {t('components.category')}
          </label>
          <select
            id="category-filter"
            class="px-3 py-2 text-base text-accent bg-background border border-accent rounded-lg"
          >
            <option value="">{t('components.allCategories')}</option>
            {categories.map((category) => (
              <option value={category}>{categoryLabel(category)}</option>
            ))}
          </select>
        </div>
        <button
          id="clear-filters"
          type="button"
          class="px-4 py-2 border-2 border-accent/40 text-accent rounded-lg hover:bg-accent/10"
        >
          {t('components.clearFilters')}
        </button>
      </div>
    </div>
  </div>
  <p id="components-empty" class="hidden text-foreground/80 mb-6" role="status">
    {t('components.noMatches')}
  </p>
  <div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-3 gap-4" id="components-grid">
    {
      components.map((component) => (
        <a
          href={`/custom-components/${component.id}`}
          class="component-card flex flex-col border border-accent/15 rounded-xl p-4 bg-accent/5 no-underline hover:border-accent/40 hover:bg-accent/10"
          data-category={component.category}
          data-title={component.title}
          data-description={component.description}
          data-tags={component.tags.join(' ')}
        >
          <h2 class="text-lg font-semibold text-accent mb-2 text-balance">{component.title}</h2>
          <p class="text-sm text-foreground/75 text-pretty">{component.description}</p>
        </a>
      ))
    }
  </div>
</Layout>

<style>
  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    .component-card {
      transition-property: border-color, background-color;
      transition-duration: 150ms;
      transition-timing-function: ease-out;
    }
  }
</style>

<script>
  const searchInput = document.getElementById('search-input') as HTMLInputElement | null
  const categoryFilter = document.getElementById('category-filter') as HTMLSelectElement | null
  const clearButton = document.getElementById('clear-filters')
  const componentCards = document.querySelectorAll('.component-card')
  const emptyState = document.getElementById('components-empty')

  const applyFilters = () => {
    const searchTerm = (searchInput?.value || '').trim().toLowerCase()
    const category = categoryFilter?.value || ''
    let visibleCount = 0

    componentCards.forEach((card) => {
      const title = card.getAttribute('data-title')?.toLowerCase() || ''
      const description = card.getAttribute('data-description')?.toLowerCase() || ''
      const tags = card.getAttribute('data-tags')?.toLowerCase() || ''
      const cardCategory = card.getAttribute('data-category') || ''
      const matchesSearch =
        !searchTerm ||
        title.includes(searchTerm) ||
        description.includes(searchTerm) ||
        tags.includes(searchTerm)
      const matchesCategory = !category || cardCategory === category
      const isMatch = matchesSearch && matchesCategory
      ;(card as HTMLElement).hidden = !isMatch
      if (isMatch) visibleCount += 1
    })

    emptyState?.classList.toggle('hidden', visibleCount > 0)
  }

  searchInput?.addEventListener('input', applyFilters)
  categoryFilter?.addEventListener('change', applyFilters)
  clearButton?.addEventListener('click', () => {
    if (searchInput) searchInput.value = ''
    if (categoryFilter) categoryFilter.value = ''
    applyFilters()
    searchInput?.focus()
  })
</script>
