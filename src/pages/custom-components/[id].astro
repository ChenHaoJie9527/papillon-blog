---
import type { GetStaticPaths } from 'astro'
import Layout from '@layouts/Layout.astro'
import ComponentShowcase from '@components/ComponentShowcase.astro'
import type { ComponentsData } from '../../custom-components'
import { t } from '../../i18n'

export const getStaticPaths = (async () => {
  const componentsData: ComponentsData = await import('../../custom-components.json')
  return componentsData.components.map((component) => ({
    params: { id: component.id },
    props: { component },
  }))
}) satisfies GetStaticPaths

const { component } = Astro.props
---

<Layout title={component.title} description={component.description}>
  <p class="mb-4">
    <a href="/custom-components" class="text-sm text-accent">{t('components.backToList')}</a>
  </p>
  <ComponentShowcase component={component} />
</Layout>
