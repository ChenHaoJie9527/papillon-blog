---
import type { GetStaticPaths } from 'astro'
import Layout from '@layouts/Layout.astro'
import { dateString, getSortedPosts, withBase } from '@utils'
import { t } from '../../i18n'
import DividerText from '@components/DividerText.astro'
import { render } from 'astro:content'
import TableOfContents from '@components/TableOfContents.astro'
import { Image } from 'astro:assets'
import GiscusLoader from '@components/GiscusLoader.astro'
import siteConfig from '../../site.config'

export const getStaticPaths = (async () => {
  const posts = await getSortedPosts()
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }))
}) satisfies GetStaticPaths

const { post } = Astro.props
const postData = post.data
const { headings, Content: PostContent } = await render(post)
---

<Layout
  title={postData.title}
  description={postData.description}
  author={postData.author}
  tags={postData.tags}
>
  <article class="max-w-full py-7.5" data-pagefind-body>
    {
      postData.coverImage && (
        <Image
          src={postData.coverImage.src}
          alt={postData.coverImage.alt}
          class="w-full rounded-xl mb-5 img-outline"
        />
      )
    }
    <h1 class="mb-3 text-2xl text-[var(--theme-h1)] font-semibold text-balance">
      # {postData.title}
    </h1>
    <div class="text-foreground/80 mb-2.5">
      <time>{dateString(postData.published)}</time>
      {
        postData.author && (
          <span class="before:content-['::'] before:inline-block before:mx-0.5">
            {postData.author}
          </span>
        )
      }
    </div>
    {
      postData.tags && (
        <div class="text-accent mb-5 lg:mb-0">
          {postData.tags.map((tag) => (
            <a
              class="underline mr-4 inline-block"
              href={withBase(`/tags/${encodeURIComponent(tag)}`)}
            >
              #{tag}
            </a>
          ))}
        </div>
      )
    }
    <div class="flex flex-col xl:gap-8 xl:flex-row xl:items-start">
      {headings.length > 0 && <TableOfContents headings={headings} />}
      <div class="mb-5 min-w-0 flex-1 prose">
        <PostContent />
      </div>
    </div>
  </article>
  {
    siteConfig.giscus && (
      <>
        <DividerText text={t('posts.comments')} />
        <GiscusLoader />
      </>
    )
  }
</Layout>
