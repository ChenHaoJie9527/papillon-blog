---
import type { GetStaticPaths } from 'astro'
import Layout from '@layouts/Layout.astro'
import { getSortedPosts } from '@utils'
import ArchiveCard from '@components/ArchiveCard.astro'
import Pagination from '@components/Pagination.astro'
import BlockHeader from '@components/BlockHeader.astro'
import siteConfig from '../../site.config'
import { t } from '../../i18n'

export const getStaticPaths = (async ({ paginate }) => {
  const sortedPosts = await getSortedPosts()
  return paginate(sortedPosts, { pageSize: siteConfig.pageSize })
}) satisfies GetStaticPaths

const { page } = Astro.props
---

<Layout title={t('nav.archive')}>
  <BlockHeader>{t('nav.archive')}</BlockHeader>
  <div class="columns-1 sm:columns-2 gap-4">
    {page.data.map((post) => (
      <ArchiveCard post={post} />
    ))}
  </div>
  <Pagination
    prevLink={page.url.prev ? page.url.prev : undefined}
    nextLink={page.url.next ? page.url.next : undefined}
  />
</Layout>
