---
import siteConfig from "../site.config";
import LightDarkAutoButton from "./LightDarkAutoButton.astro";
import Search from "./Search.astro";
import SelectTheme from "./SelectTheme.astro";
import NavLink from "./NavLink.astro";
import { t } from "../i18n";
import { withBase, withoutBase } from "@utils";

const lightDarkAutoTheme = siteConfig.themes.mode === "light-dark-auto";
const selectTheme =
	siteConfig.themes.mode === "select" && siteConfig.themes.include.length > 1;
const currentPath = withoutBase(Astro.url.pathname);
---

<header class="site-header">
  <div class="site-header-left">
    <button
      id="sidebar-toggle"
      class="press-scale lg:hidden px-3 min-h-10 min-w-10 cursor-pointer border-2 rounded-xl bg-background text-accent"
      type="button"
      aria-expanded="false"
      aria-controls="site-sidebar"
      aria-label={t('sidebar.open')}
    >
      ☰
    </button>
    <a
      id="logo"
      href={withBase("/")}
      class="block px-4 py-1.5 max-w-full no-underline bg-accent text-background font-bold rounded-xl"
    >
      {siteConfig.title}
    </a>
  </div>

  <nav aria-label="菜单" class="site-header-nav hidden md:block">
    <ul class="flex flex-row items-center gap-0 text-accent m-0 p-0">
      {
        siteConfig.navLinks.map((link, index) => (
          <li class="flex items-center">
            {index > 0 && <span class="mx-3 text-foreground/30" aria-hidden="true">|</span>}
            <NavLink link={link} plain currentPath={currentPath} />
          </li>
        ))
      }
    </ul>
  </nav>

  <div class="site-header-right">
    <Search />
    {lightDarkAutoTheme && <LightDarkAutoButton />}
    {selectTheme && <SelectTheme />}
  </div>
</header>

<script>
  const toggle = document.getElementById('sidebar-toggle')
  const sidebar = document.getElementById('site-sidebar')
  const backdrop = document.getElementById('sidebar-backdrop')

  const setOpen = (open: boolean) => {
    sidebar?.classList.toggle('is-open', open)
    if (backdrop) backdrop.hidden = !open
    toggle?.setAttribute('aria-expanded', open ? 'true' : 'false')
    document.body.classList.toggle('sidebar-open', open)
  }

  toggle?.addEventListener('click', () => {
    const open = !sidebar?.classList.contains('is-open')
    setOpen(open)
  })
  backdrop?.addEventListener('click', () => setOpen(false))
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') setOpen(false)
  })
</script>
