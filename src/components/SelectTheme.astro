---
import { Icon } from 'astro-icon/components'
import siteConfig from '../site.config'
import { t } from '../i18n'
import { getThemeLabel } from '../theme-labels'
---

<select-theme class="inline-flex" id="theme-select">
  <button
    class="press-scale hover:text-accent flex cursor-pointer items-center justify-center rounded-md min-h-10 min-w-10"
    data-open-modal
    disabled
    type="button"
  >
    <Icon name="palette" class="size-6 text-accent" />
    <span class="sr-only">{t('theme.select')}</span>
  </button>
  <dialog
    aria-label={t('theme.select')}
    class="site-dialog text-foreground! bg-background w-[min(42rem,calc(100vw-2rem))] max-h-[min(40rem,85vh)] border-double! border-4 border-accent/30 shadow-sm backdrop:backdrop-blur-sm open:flex mx-auto mt-10 sm:mt-16 mb-auto rounded-xl"
  >
    <div class="dialog-frame relative flex grow flex-col gap-3 px-6 py-4 w-full min-h-0">
      <button
        aria-label={t('common.close')}
        class="press-scale cursor-pointer absolute top-2 right-2 rounded-full min-h-10 min-w-10 flex items-center justify-center"
        data-close-modal
        type="button"
      >
        <Icon name="circle-x" class="size-6 text-accent/50" />
      </button>
      <h2 class="text-lg font-semibold pt-2 pr-10">{t('theme.select')}</h2>
      <label class="block">
        <span class="sr-only">{t('theme.searchPlaceholder')}</span>
        <input
          id="theme-filter"
          type="search"
          autocomplete="off"
          placeholder={t('theme.searchPlaceholder')}
          class="w-full text-base bg-transparent text-foreground border border-accent/40 p-2.5 rounded-xl"
        />
      </label>
      <p id="theme-empty" class="hidden text-sm text-foreground/70 px-2 py-3">
        {t('theme.noResults')}
      </p>
      <ul
        id="theme-change-list"
        class="grid grid-cols-1 sm:grid-cols-2 gap-1 bg-background text-accent m-0 p-1 rounded-xl overflow-y-auto min-h-0 max-h-[min(28rem,60vh)]"
      >
        {
          siteConfig.themes.include.map((theme) => {
            const label = getThemeLabel(theme)
            return (
              <li data-theme-label={`${label} ${theme}`.toLowerCase()}>
                <button
                  class="press-scale w-full rounded-sm py-2.5 px-3 text-left"
                  data-theme={theme}
                  type="button"
                >
                  {label}
                </button>
              </li>
            )
          })
        }
      </ul>
    </div>
  </dialog>
</select-theme>

<style>
  button.current-theme {
    background-color: color-mix(in srgb, var(--theme-accent) 16%, transparent 84%);
    font-weight: 600;
  }

  #theme-change-list button:hover:not(.current-theme) {
    background-color: color-mix(in srgb, var(--theme-accent) 8%, transparent 92%);
  }
</style>

<script>
  class SelectTheme extends HTMLElement {
    #closeBtn: HTMLButtonElement | null
    #dialog: HTMLDialogElement | null
    #dialogFrame: HTMLDivElement | null
    #openBtn: HTMLButtonElement | null
    #filterInput: HTMLInputElement | null
    #emptyMessage: HTMLParagraphElement | null
    #controller: AbortController

    constructor() {
      super()
      this.#openBtn = this.querySelector<HTMLButtonElement>('button[data-open-modal]')
      this.#closeBtn = this.querySelector<HTMLButtonElement>('button[data-close-modal]')
      this.#dialog = this.querySelector<HTMLDialogElement>('dialog')
      this.#dialogFrame = this.querySelector('.dialog-frame')
      this.#filterInput = this.querySelector<HTMLInputElement>('#theme-filter')
      this.#emptyMessage = this.querySelector<HTMLParagraphElement>('#theme-empty')
      this.#controller = new AbortController()

      if (this.#openBtn) {
        this.#openBtn.addEventListener('click', this.openModal)
        this.#openBtn.disabled = false
      }

      if (this.#closeBtn) {
        this.#closeBtn.addEventListener('click', this.closeModal)
      }

      if (this.#dialog) {
        this.#dialog.addEventListener('close', () => {
          window.removeEventListener('click', this.onWindowClick)
        })
      }

      this.querySelectorAll('#theme-change-list button').forEach((button) => {
        button.addEventListener('click', (ev) => {
          ev.preventDefault()
          const themeId = button.getAttribute('data-theme')
          if (themeId) {
            this.applyTheme(themeId)
            this.closeModal()
          }
        })
      })

      this.#filterInput?.addEventListener('input', () => this.filterThemes())
    }

    connectedCallback() {
      window.addEventListener('keydown', this.onWindowKeydown, {
        signal: this.#controller.signal,
      })
    }

    disconnectedCallback() {
      this.#controller.abort()
    }

    applyTheme(themeId: string) {
      const root = document.documentElement
      root.classList.add('theme-switching')
      root.setAttribute('data-theme', themeId)
      localStorage.setItem('data-theme', themeId)
      void document.body.offsetHeight
      requestAnimationFrame(() => {
        requestAnimationFrame(() => {
          root.classList.remove('theme-switching')
        })
      })
    }

    filterThemes() {
      const query = (this.#filterInput?.value || '').trim().toLowerCase()
      const items = this.querySelectorAll('#theme-change-list li')
      let visibleCount = 0
      items.forEach((item) => {
        const label = item.getAttribute('data-theme-label') || ''
        const themeId = item.querySelector('button')?.getAttribute('data-theme') || ''
        const isMatch = !query || label.includes(query) || themeId.includes(query)
        ;(item as HTMLElement).hidden = !isMatch
        if (isMatch) visibleCount += 1
      })
      this.#emptyMessage?.classList.toggle('hidden', visibleCount > 0)
    }

    openModal = (event?: MouseEvent) => {
      if (!this.#dialog) return
      this.highlightCurrentTheme()
      if (this.#filterInput) this.#filterInput.value = ''
      this.filterThemes()
      document.body.classList.add('overflow-hidden')
      this.#dialog.showModal()
      this.#filterInput?.focus()
      event?.stopPropagation()
      window.addEventListener('click', this.onWindowClick, {
        signal: this.#controller.signal,
      })
    }

    closeModal = () => {
      document.body.classList.remove('overflow-hidden')
      this.#dialog?.close()
    }

    onWindowClick = (event: MouseEvent) => {
      const isLink = 'href' in (event.target || {})
      if (
        isLink ||
        (document.body.contains(event.target as Node) &&
          !this.#dialogFrame?.contains(event.target as Node))
      ) {
        this.closeModal()
      }
    }

    onWindowKeydown = (e: KeyboardEvent) => {
      if (e.key === 'Escape' && this.#dialog?.open) {
        this.closeModal()
      }
    }

    highlightCurrentTheme() {
      const currentTheme = document.documentElement.getAttribute('data-theme')
      this.querySelectorAll('#theme-change-list li').forEach((listItem) => {
        const button = listItem.querySelector('button')
        if (!button) return
        button.classList.toggle(
          'current-theme',
          button.getAttribute('data-theme') === currentTheme,
        )
      })
    }
  }

  customElements.define('select-theme', SelectTheme)
</script>
