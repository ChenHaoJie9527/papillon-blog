---
import { Image } from 'astro:assets'
import ReactGithubCalendar from './ReactGithubCalendar'
import type { FrontmatterImage } from '../types'

interface Props {
  avatarImage?: FrontmatterImage
  githubCalendar?: string
}
const { avatarImage, githubCalendar } = Astro.props
---

<div class="mb-8 flex flex-col lg:flex-row lg:items-center gap-6">
  <div class="flex items-center gap-5 min-w-0 lg:max-w-md xl:max-w-lg shrink-0">
    {
      avatarImage && (
        <Image
          src={avatarImage.src}
          alt={avatarImage.alt}
          class="rounded-full border-4 border-accent/20 size-24 aspect-square shrink-0"
        />
      )
    }
    <div class="prose min-w-0">
      <slot />
    </div>
  </div>
  {
    githubCalendar && (
      <div class="flex-1 min-w-0 overflow-x-auto">
        <ReactGithubCalendar username={githubCalendar} client:only />
      </div>
    )
  }
</div>

<style is:global>
  .github-calendar rect {
    stroke: var(--theme-foreground) !important;
    stroke-opacity: 0.1 !important;
  }
</style>
